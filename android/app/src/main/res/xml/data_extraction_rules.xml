<?xml version="1.0" encoding="utf-8"?>
<!--
  Session tokens live in encrypted preferences. They are excluded from both
  cloud backup and device-to-device transfer so an account is never cloned onto
  another device by restoring a backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
