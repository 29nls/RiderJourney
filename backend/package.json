{
  "name": "riderjourney-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "test": "npm run build && node --test dist/test",
    "migration:run": "node dist/db/migrate-cli.js up",
    "migration:status": "node dist/db/migrate-cli.js status",
    "retention:run": "node dist/ops/retention-cli.js",
    "billing:reconcile": "node dist/billing/reconcile-cli.js",
    "admin:bootstrap": "node dist/admin/bootstrap-cli.js",
    "openapi": "node dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^6.1.0",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-postgis": "^0.3.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0"
  }
}
