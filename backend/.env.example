[TEMPLATE]
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://riderjourney:riderjourney@localhost:5432/riderjourney
DATABASE_SSL=false
AUTH_MODE=local
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_EXPOSE_DEV_TOKENS=false
# Wajib 32 byte base64 untuk mengenkripsi nomor polisi. Buat dengan: openssl rand -base64 32
PLATE_ENCRYPTION_KEY=
ROUTING_PROVIDER=
ROUTING_BASE_URL=
ROUTING_API_KEY=
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
GEOCODING_API_KEY=
MAP_TILE_STYLE_URL=
MAP_ATTRIBUTION=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Phase 2 convoy realtime. REDIS_URL wajib saat NODE_ENV=production; tanpa itu
# server memakai store memori khusus satu proses (hanya untuk development/test).
REDIS_URL=
# Wajib di produksi. Bila kosong, server memakai AUTH_JWT_SECRET sebagai fallback dev.
INVITE_HMAC_PEPPER=
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_POSITION_TTL_SECONDS=300
CONVOY_STALE_AFTER_SECONDS=30
CONVOY_CAPACITY_DEFAULT=3
CONVOY_CAPACITY_MAX=30
CONVOY_INVITE_LINK_BASE=riderjourney://convoy/join?code=
# Phase 3 convoy chat, voice, hazards, emergency contacts, communities.
# Batas Throttler HTTP global tetap 120/menit per klien; tiga nilai di bawah
# adalah batas khusus endpoint yang tercatat di docs/SECURITY_AND_PRIVACY.md.
CHAT_RATE_LIMIT_PER_MINUTE=30
# Pesan yang lebih panjang dari ini belum bisa diketik penerima, jadi dikirim
# terlalu cepat dianggap spam dan ditolak sebelum disimpan.
CHAT_TYPING_CHARS_PER_SECOND=4
# Hazard: TTL default 2 jam, batas maksimum TTL selalu <= ttl default, radius
# dedup 80 m, dan 12 laporan per jam per rider.
HAZARD_TTL_SECONDS=7200
HAZARD_MAX_TTL_SECONDS=14400
HAZARD_DUPLICATE_RADIUS_M=80
HAZARD_RATE_LIMIT_PER_HOUR=12
# LiveKit voice room. Bila ketiganya kosong endpoint token membalas 503 dan
# aplikasi menyembunyikan PTT; isi LIVEKIT_API_SECRET hanya di secret manager.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_TOKEN_TTL_SECONDS=300
# AES-256-GCM untuk kontak darurat pribadi. Fallback ke PLATE_ENCRYPTION_KEY bila kosong.
CONTACT_ENCRYPTION_KEY=
# Object storage untuk foto hazard dan logo komunitas (signed upload).
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_UPLOAD_TTL_SECONDS=300
MEDIA_MAX_BYTES=5242880
# Video posts/albums use a larger bound than photos; the service still enforces
# the per-purpose limit before any upload intent is issued.
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_SIGNED_URL_TTL_SECONDS=300
ALBUM_QUOTA_BYTES_DEFAULT=209715200
POST_RATE_LIMIT_PER_HOUR=20
COMMENT_RATE_LIMIT_PER_HOUR=120
# Opsional: tanpa key ini notifikasi tetap tersimpan sebagai in-app dan
# perangkat push terdaftar, tetapi pengiriman FCM dilaporkan nonaktif.
FCM_SERVER_KEY=
FCM_PROJECT_ID=
# Phase 5 paid features. Both switches must be on before a purchase or a manual
# grant can entitle an account: this deployment switch and admin_config.features.
# Leave both false until Play products, Terms, Privacy Policy, and legal review exist.
BILLING_ENABLED=false
PAID_FEATURES_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=
# Absolute path or raw service-account JSON. Keep the value in a secret manager,
# never in the repository or the admin web bundle.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_API_BASE=https://androidpublisher.googleapis.com
# Optional short-lived token for local provider tests only. Production uses the
# service account JWT flow above.
GOOGLE_PLAY_ACCESS_TOKEN=
# Pub/Sub push authenticates with X-Billing-Secret in this baseline. Put the
# backend behind an OIDC-validating gateway before production.
BILLING_NOTIFICATION_SECRET=
# HMAC pepper for redeem codes. Falls back to AUTH_JWT_SECRET only for development.
REDEEM_CODE_PEPPER=
ADMIN_STEP_UP_TTL_SECONDS=600
DATA_EXPORT_TTL_DAYS=7
ACCOUNT_DELETION_GRACE_DAYS=30
